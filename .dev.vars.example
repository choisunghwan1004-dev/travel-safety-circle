# 로컬 개발 전용. 값이 들어간 .dev.vars는 커밋하지 않습니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# 정기 점검 상태는 계정별 alert_monitors의 최근 실행 기록을 사용합니다.

# Server only: 64 hex characters, stable per installation. Never commit the value.
# Each traveler registers their own OpenAI key in the AI settings screen.
USER_KEY_ENCRYPTION_SECRET=

# Optional public map provider switch; defaults work without API keys
# GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
